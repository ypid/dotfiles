--verbose

--list-formats
# --no-simulate is needed so that --list-formats still downloads the video.
--no-simulate

# Determine best for video-only and audio-only individually first before checking if a combined file is better.
# If video-only and audio-only together are smaller than one file with both than download two files files and mux them together.
--format="bestvideo+(bestaudio[format_note*=original][language^=en]/bestaudio[format_note*=original][language^=de]/bestaudio[language^=en]/bestaudio[language^=de]/bestaudio)/best"

--embed-chapters
--output="%(uploader)s - %(title)s - %(upload_date>%Y-%m-%d)s [%(resolution)s %(vcodec)s %(acodec)s %(format_id)s] [%(id)s].%(ext)s"

# mp4 container is supported everywhere
# (https://jellyfin.org/docs/general/clients/codec-support/) but it results in
# a video file without audio if the audio codec is opus for example.
# https://wiki.xiph.org/Mp4Opus
# Slightly related: https://github.com/yt-dlp/yt-dlp/issues/10553
# --merge-output-format=mp4

--check-formats

--download-archive ~/.config/yt-dlp/download-archive.list

--config-locations ~/.config/yt-dlp_local.conf
